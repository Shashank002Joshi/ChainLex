# Copy to .env; all tokens must be distinct. Empty tokens authorize nobody.
CHAINLEX_MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
CHAINLEX_DATABASE=chainlex_dev
CHAINLEX_DATABASE_TIMEOUT_MS=2000
CHAINLEX_DEMO_TENANT_ID=bank_a
CHAINLEX_ANALYST_TOKEN=
CHAINLEX_OFFICER_TOKEN=
CHAINLEX_SIMULATOR_TOKEN=
CHAINLEX_SIMULATOR_URL=http://127.0.0.1:8001
CHAINLEX_SIMULATOR_CONFIRMATION_SECONDS=2

# Shared embedding configuration, used by country_cli ingestion.
CHAINLEX_VOYAGE_API_KEY=
CHAINLEX_EMBEDDING_MODEL=voyage-finance-2
CHAINLEX_RERANK_MODEL=rerank-2.5
# Reserved for the analyst implementation.
CHAINLEX_LLM_API_KEY=
CHAINLEX_LLM_MODEL=

CHAINLEX_LEASE_SECONDS=10
CHAINLEX_HEARTBEAT_SECONDS=3
CHAINLEX_POLL_SECONDS=1
